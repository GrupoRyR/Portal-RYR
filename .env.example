# =============================================================================
# Portal RYR - environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` holds secrets and
# must NEVER be committed. Values below are placeholders only.
#
# The active (uncommented) values target LOCAL development with SQLite.
# For PRODUCTION (cPanel, apps.segurexlatam.net) apply the values from the
# "PRODUCTION" blocks below.
# =============================================================================

APP_NAME="Portal RYR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- PRODUCTION: application -------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://apps.segurexlatam.net
# (generate APP_KEY on the server with: php artisan key:generate)

# --- Logging -----------------------------------------------------------------
# One file per day in storage/logs, kept for LOG_DAILY_DAYS days.
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# PRODUCTION: LOG_LEVEL=warning

# --- Database: LOCAL (SQLite) ------------------------------------------------
# Uses database/database.sqlite
DB_CONNECTION=sqlite

# --- Database: PRODUCTION (MySQL 8, utf8mb4) ---------------------------------
# Create the database and user in cPanel > MySQL Databases, then use:
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# --- Session, cache and queue ------------------------------------------------
# Shared hosting has no Redis or long-running workers: everything uses the
# database (tables created by `php artisan migrate`).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: the session cookie only travels over HTTPS.
# SESSION_SECURE_COOKIE=true

CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail --------------------------------------------------------------------
# Local development writes mail to the log. Configure SMTP in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
